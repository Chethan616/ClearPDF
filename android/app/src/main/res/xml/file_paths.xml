<?xml version="1.0" encoding="utf-8"?>
<!-- Files of Artefact's that another app may reach through its FileProvider: a document being
     shared, printed or opened in another app, a photo the camera app takes for Scan, and one it
     takes for a note (written straight into the notes' media folder) -->
<paths>
    <cache-path name="share" path="share/" />
    <cache-path name="camera" path="camera/" />
    <files-path name="notes" path="notes/media/" />
</paths>
