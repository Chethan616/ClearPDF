<?xml version="1.0" encoding="utf-8"?>
<!-- The app, coming in over Quick Preview's card: a short fade onto the viewer's plain ground; the
     document then rises over it as it does when opened from the desk -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ui_curve">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="180" />
</set>
